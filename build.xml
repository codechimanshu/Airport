<?xml version="1.0" encoding="UTF-8"?>
<project name="Airport" default="build" basedir=".">
    <description>Airport Project - Java Practice Hub Build</description>
    
    <!-- Set properties -->
    <!-- Prefer jets/src if it exists (some workflows expect that layout); fall back to src otherwise. -->
    <condition property="src" value="jets/src" else="src">
        <available file="jets/src" type="dir"/>
    </condition>

    <property name="build" location="build"/>
    <property name="dist" location="dist"/>
    <property name="classes" location="${build}/classes"/>
    
    <!-- Detect if there are any Java source files to compile -->
    <condition property="has.sources">
        <resourcecount when="greater" count="0">
            <fileset dir="${src}" includes="**/*.java"/>
        </resourcecount>
    </condition>

    <!-- Initialize -->
    <target name="init">
        <mkdir dir="${classes}"/>
        <mkdir dir="${dist}"/>
    </target>
    
    <!-- Compile Java source files only when present -->
    <target name="compile" depends="init" if="has.sources" description="Compile Java source files">
        <javac srcdir="${src}" destdir="${classes}" includeantruntime="false" debug="true">
            <compilerarg value="-Xlint:unchecked"/>
        </javac>
    </target>

    <!-- Informative target when there are no sources -->
    <target name="no-sources" unless="has.sources">
        <echo message="No Java source files found in ${src}; skipping compilation."/>
    </target>

    <!-- Top-level build: either compile (if sources exist) or run no-sources -->
    <target name="build" depends="compile,no-sources" description="Top-level build"/>
    
    <!-- Clean build artifacts -->
    <target name="clean" description="Clean build and dist directories">
        <delete dir="${build}"/>
        <delete dir="${dist}"/>
    </target>
    
    <!-- Rebuild -->
    <target name="rebuild" depends="clean,build" description="Clean and rebuild"/>
    
</project>
