<?xml version="1.0" encoding="UTF-8"?>
<project name="Airport" default="build" basedir=".">
    <description>Airport Project - Java Practice Hub Build</description>
    
    <!-- Set properties -->
    <!-- Prefer jets/src if it exists (some workflows expect that layout); fall back to src otherwise. -->
    <condition property="src" value="jets/src" else="src">
        <available file="jets/src" type="dir"/>
    </condition>

    <property name="build" location="build"/>
    <property name="dist" location="dist"/>
    <property name="classes" location="${build}/classes"/>
    
    <!-- Initialize -->
    <target name="init">
        <mkdir dir="${classes}"/>
        <mkdir dir="${dist}"/>
        <!-- Ensure the source directory exists so javac doesn't fail when there are no sources -->
        <mkdir dir="${src}"/>
    </target>
    
    <!-- Compile Java source files -->
    <target name="build" depends="init" description="Compile all Java source files">
        <javac srcdir="${src}" destdir="${classes}" includeantruntime="false" debug="true">
            <compilerarg value="-Xlint:unchecked"/>
        </javac>
    </target>
    
    <!-- Clean build artifacts -->
    <target name="clean" description="Clean build and dist directories">
        <delete dir="${build}"/>
        <delete dir="${dist}"/>
    </target>
    
    <!-- Rebuild -->
    <target name="rebuild" depends="clean,build" description="Clean and rebuild"/>
    
</project>
